# ---------------------------------------
# Main application-wide .gitignore
# ---------------------------------------

# macOS files
.DS_Store

# Med-Data specific files
.dev-secrets.md

# Output directories (should be external to repo)
med-output/
extract/
log/

# VS Code config files
.vscode

# Python
pycache/ *.pyc
__pycache__/

#Logs
*.Log

# Environments
.env
.env_local
.env_cdw
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js dependencies and files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.eslintcache

# Node.js runtime files
*.pid
*.seed
*.pid.lock

# Database files (if using local SQLite for testing)
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
.tmp/

# Claude Code specific files
.claude_history
.claude_session
